{
    "name": "frontend",
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "webpack serve --mode development --config webpack.config.mjs",
        "build": "webpack --mode production --config webpack.config.mjs",
        "lint": "eslint --config eslint.config.js .",
        "lint:fix": "eslint --config eslint.config.js . --fix",
        "lint:css": "stylelint \"src/**/*.{css,scss}\"",
        "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
        "format": "prettier --write src",
        "format:css": "prettier --write \"src/**/*.{css,scss}\"",
        "lint:all": "npm run lint && npm run lint:css",
        "fix:all": "npm run lint:fix && npm run lint:css:fix && npm run format",
        "prepare": "cd .. && husky install frontend/.husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "lint-staged": {
        "src/**/*.{css,scss}": [
            "stylelint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@hookform/resolvers": "^5.0.1",
        "@phosphor-icons/react": "^2.1.10",
        "classnames": "^2.5.1",
        "has-proto": "^1.2.0",
        "phosphor-icons": "^1.4.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.56.4",
        "react-router-dom": "^7.6.1",
        "react-simple-maps": "^1.0.0",
        "react-spinners": "^0.17.0",
        "swr": "^2.3.3",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@babel/core": "^7.23.9",
        "@babel/eslint-parser": "^7.25.8",
        "@babel/preset-env": "^7.23.9",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@eslint/eslintrc": "^2.1.4",
        "@eslint/js": "^8.56.0",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@types/react-router-dom": "^5.3.3",
        "@types/react-simple-maps": "^3.0.6",
        "@types/yup": "^0.29.14",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "ajv": "^8.17.1",
        "autoprefixer": "^10.4.21",
        "babel-loader": "^9.1.3",
        "css-loader": "^6.9.1",
        "cssnano": "^7.0.7",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "globals": "^13.24.0",
        "html-webpack-plugin": "^5.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.0",
        "postcss": "^8.5.4",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-import": "^16.1.0",
        "postcss-loader": "^8.1.1",
        "postcss-nested": "^7.0.2",
        "postcss-preset-env": "^10.2.0",
        "prettier": "^3.2.4",
        "style-loader": "^3.3.4",
        "stylelint": "^16.20.0",
        "stylelint-config-standard": "^38.0.0",
        "typescript": "^4.9.5",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
